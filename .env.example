# =============================================================================
# Generic Medicine Store — Environment Variables Reference
# Project: generic-medicine-store (kishori)
# Phase:   Phase 1 MVP & Core Marketplace Foundation (v1.4.0)
# =============================================================================
# INSTRUCTIONS:
#   Copy this file to .env and fill in real values.
#   Never commit .env to version control.
#   VITE_ prefix = safe to expose to browser bundle.
#   Non-prefixed = server-only, never import into frontend code.
# =============================================================================

# ─── AI / OCR Integration ────────────────────────────────────────────────────

# Google Gemini AI API key for prescription OCR and salt disambiguation (ADR-009).
# Obtain from: https://aistudio.google.com/app/apikey
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="your-gemini-api-key-here"

# Expose Gemini key to frontend for client-side salt search fallback (ADR-009 Tier 2).
VITE_GEMINI_API_KEY="your-gemini-api-key-here"

# ─── Application URLs ─────────────────────────────────────────────────────────

# Public base URL where this application is hosted (used in OAuth callbacks, signed URLs).
# AI Studio automatically injects this with the Cloud Run service URL.
APP_URL="http://localhost:3000"

# Frontend API base URL (exposed to Vite bundle — must NOT contain secrets).
VITE_API_BASE_URL="http://localhost:3001"

# ─── Server Configuration ─────────────────────────────────────────────────────

# Express server port (default: 3001).
PORT=3001

# Node environment: development | staging | production
NODE_ENV="development"

# ─── JWT & Authentication (ADR-010) ──────────────────────────────────────────

# RS256 private key for signing JWTs (PEM format, newlines escaped as \n).
# Server-only — NEVER prefix with VITE_.
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----"

# RS256 public key for verifying JWTs.
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_KEY_HERE\n-----END PUBLIC KEY-----"

# JWT access token TTL in seconds (default: 86400 = 24 hours).
JWT_EXPIRES_IN_SECONDS=86400

# ─── PostgreSQL Multi-Tenant Database (ADR-001) ───────────────────────────────

# Primary PostgreSQL connection string (schema-per-tenant model).
# Format: postgresql://user:password@host:port/database
DATABASE_URL="postgresql://gms_user:your_password@localhost:5432/generic_medicine_store"

# Database connection pool max size.
DATABASE_POOL_MAX=20

# ─── Redis Sentinel Cache (ADR-004) ───────────────────────────────────────────

# Redis connection URL for Buy-Box cache and ephemeral cart storage.
REDIS_URL="redis://localhost:6379"

# Redis Sentinel master name (for high-availability Sentinel setup).
REDIS_SENTINEL_MASTER="mymaster"

# Redis Sentinel endpoints (comma-separated host:port pairs).
# REDIS_SENTINELS="sentinel1:26379,sentinel2:26379,sentinel3:26379"

# Buy-Box cache TTL in seconds (default: 60 — recalculated every minute per ADR-004).
BUY_BOX_CACHE_TTL_SECONDS=60

# ─── Prescription Storage (ADR-010) ──────────────────────────────────────────

# AWS S3 or GCS bucket name for encrypted prescription image storage.
# Prescriptions are served via signed short-lived URLs (TTL < 15 minutes).
PRESCRIPTION_BUCKET_NAME="gms-prescriptions-encrypted"

# S3 / GCS region.
CLOUD_STORAGE_REGION="us-east-1"

# AWS credentials (server-only).
# AWS_ACCESS_KEY_ID="your-aws-access-key"
# AWS_SECRET_ACCESS_KEY="your-aws-secret-key"

# Signed URL TTL in seconds for prescription downloads (max 900 = 15 minutes per ADR-010).
PRESCRIPTION_URL_TTL_SECONDS=900

# ─── Cloudflare Edge (Production) ────────────────────────────────────────────

# Cloudflare API token for WAF and geo-routing rules management.
# CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"

# Cloudflare Zone ID for the platform domain.
# CLOUDFLARE_ZONE_ID="your-zone-id"

# ─── IoT Telemetry (ADR-008) ─────────────────────────────────────────────────

# MQTT broker endpoint for cold-chain IoT temperature ingestion.
# MQTT_BROKER_URL="mqtt://iot.genericstore.health:1883"

# MQTT authentication credentials.
# MQTT_USERNAME="iot-ingest-service"
# MQTT_PASSWORD="your-mqtt-password"

# ─── Commission & Payments (ADR-007) ─────────────────────────────────────────

# Stripe secret key for escrow payment processing (server-only).
# STRIPE_SECRET_KEY="sk_live_your_stripe_secret"

# Stripe webhook signing secret for verifying event payloads.
# STRIPE_WEBHOOK_SECRET="whsec_your_signing_secret"

# Razorpay key (India market alternative to Stripe).
# RAZORPAY_KEY_ID="rzp_live_your_key_id"
# RAZORPAY_KEY_SECRET="your_razorpay_secret"

# ─── Feature Flags ────────────────────────────────────────────────────────────

# Set to 'true' to enable Gemini AI OCR on the server-side prescription parser.
ENABLE_GEMINI_OCR=false

# Set to 'true' to use live PostgreSQL instead of in-memory StorageService.
ENABLE_LIVE_DATABASE=false

# Set to 'true' to use live Redis Buy-Box cache instead of in-process calculation.
ENABLE_REDIS_BUY_BOX=false

# Disable Vite HMR in AI Studio / agent-edit environments to prevent flickering.
DISABLE_HMR=false
